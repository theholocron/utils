{
  "name": "@theholocron/utils",
  "version": "1.4.2",
  "private": true,
  "description": "Lightweight TypeScript utility packages for arrays, strings, dates, environment detection, and more.",
  "keywords": [
    "array",
    "date-time",
    "developer-tools",
    "environment",
    "nodejs",
    "storage",
    "string",
    "typescript",
    "uri",
    "utilities"
  ],
  "homepage": "https://docs.theholocron.dev/utils/",
